# --- Front end (npm run dev / build) ---
# URL of the AIS proxy: an absolute wss:// URL of the Cloudflare Worker (see proxy/README.md),
# or /ais when the app runs with server/ (npm start, Docker). Empty disables live AIS and levels.
VITE_AIS_PROXY_URL=

# --- Server (npm start, Docker Compose) ---
# Host port for Docker Compose.
PORT=8533
# aisstream.io API key for live AIS. Empty disables /ais.
AISSTREAM_API_KEY=
# Rijkswaterstaat location code of an ARK gauge near Breukelen (waterinfo.rws.nl). Empty: streefpeil.
RWS_ARK_LOCATION_CODE=
# HDSR Lizard timeseries UUID of a Vecht gauge near Breukelen (hdsr.lizard.net). Empty: streefpeil.
HDSR_VECHT_TIMESERIES_UUID=
